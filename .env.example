# ─────────────────────────────────────────────────────────────
# 숨쉬는길 환경변수
#
# 이 파일을 복사해서 .env.local 로 만든 뒤 값을 채우세요.
#   cp .env.example .env.local
# .env.local 은 git에 올라가지 않습니다. 인증키를 절대 커밋하지 마세요.
# ─────────────────────────────────────────────────────────────

# mock : 공공데이터 API를 호출하지 않고 src/mocks/raw 의 가짜 응답을 사용 (기본값)
# live : 실제 공공데이터포털 API 호출
NEXT_PUBLIC_DATA_MODE=mock

# 공공데이터포털(data.go.kr) 일반 인증키 — Decoding 값을 넣으세요.
# 마이페이지 > 인증키 발급현황 에서 확인할 수 있습니다.
# 비어 있으면 DATA_MODE 값과 무관하게 자동으로 mock 으로 동작합니다.
DATA_GO_KR_SERVICE_KEY=

# ─────────────────────────────────────────────────────────────
# 기상청 API허브 (apihub.kma.go.kr) — 단기예보 / 초단기실황
#
# ⚠ 위 data.go.kr 키와 다른 키입니다.
# 단기예보·초단기실황은 공공데이터포털이 아니라 API허브에서 받습니다.
# 인증 파라미터도 serviceKey 가 아니라 authKey 이고 호스트도 다릅니다.
# 발급: https://apihub.kma.go.kr → 회원가입 → 마이페이지 → 인증키
# ─────────────────────────────────────────────────────────────
KMA_APIHUB_KEY=

# ─────────────────────────────────────────────────────────────
# TMAP 보행자 경로 API (SK Open API) — 선택
#
# 값이 있으면 경로 안내가 실제 도로 기반으로 동작하고,
# 비어 있으면 대전 전역 격자 위 A* 근사 경로로 자동으로 떨어집니다.
# 발급: https://tmapapi.tmapmobility.com → 회원가입 → 앱 등록 → 앱키 복사
#
# NEXT_PUBLIC_ 을 붙이지 마세요. 브라우저에 노출되면 남용될 수 있습니다.
# ─────────────────────────────────────────────────────────────
TMAP_APP_KEY=
