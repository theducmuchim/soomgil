# ─────────────────────────────────────────────────────────────
# 숨쉬는길 환경변수
#
# 이 파일을 복사해서 .env.local 로 만든 뒤 값을 채우세요.
#   cp .env.example .env.local
# .env.local 은 git에 올라가지 않습니다. 인증키를 절대 커밋하지 마세요.
# ─────────────────────────────────────────────────────────────

# mock : 공공데이터 API를 호출하지 않고 src/mocks/raw 의 가짜 응답을 사용 (기본값)
# live : 실제 공공데이터포털 API 호출
NEXT_PUBLIC_DATA_MODE=mock

# 공공데이터포털(data.go.kr) 일반 인증키 — Decoding 값을 넣으세요.
# 마이페이지 > 인증키 발급현황 에서 확인할 수 있습니다.
# 비어 있으면 DATA_MODE 값과 무관하게 자동으로 mock 으로 동작합니다.
DATA_GO_KR_SERVICE_KEY=
